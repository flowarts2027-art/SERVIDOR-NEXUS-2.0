{
  "name": "nexus-radar-preview",
  "main": "src/commercial-radar-preview.js",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "nexus-radar-preview",
    "database_id": "REPLACE_WITH_NEW_PREVIEW_D1_DATABASE_ID"
  }]
}
